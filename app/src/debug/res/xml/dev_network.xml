<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain http to the PC through `adb reverse`, for the updater's stand-in
     release feed (files/dev_update_feed, e.g. http://127.0.0.1:8765/repos/JoeysRetroHandhelds/joey64).
     Release builds keep Android's default: https only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
