<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <!-- Android TV (approved mockup 2026-11-09): no touchscreen needed, and offered on TVs -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The in-app updater (docs/launcher-build-plan.md, Phase 0b): GitHub releases, then Android's installer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Netplay: rooms on this Wi-Fi find each other by broadcast, which some Wi-Fi drivers drop without a multicast lock. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- the low-latency Wi-Fi lock while in a netplay room (MainActivity.netWifiLock) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Joey64"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:extractNativeLibs="true"
        android:appCategory="game"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <!-- No Android backup (Joey 2026-11-08): its scheduled full backup force-stops the app, and on the Thor
             it killed a game mid-play (2026-11-07 23:17, signal 9). Joey64's own Back up Joey64 (Settings ›
             Saves) and a picked data folder are how saves are kept. -->
        <!-- Every config change is handled in place: a recreated activity would stop the running game
             (dark mode switching at sunset, docking to a TV, font size, density) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|keyboard|keyboardHidden|navigation|touchscreen|locale|layoutDirection|colorMode">
            <!-- Lets launchers / file managers hand us a ROM; the app icon opens the launcher below -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
            </intent-filter>
        </activity>
        <!-- Joey64's own game starts (the library, a game switch, a settings restart) come through here. Not exported, so
             only Joey64 can use it: MainActivity takes the launcher's extras (netplay, MD5, state, cartridge, save name)
             only from a start through this alias (code audit 3, H9) -->
        <activity-alias
            android:name=".GameStart"
            android:targetActivity=".MainActivity"
            android:exported="false" />
        <!-- The app's home: first run, then the library. It starts games in MainActivity. -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- The TV's Apps row, with the banner (Android TV mockup 2026-11-09, banner A) -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Zipped ROMs unpacked to cache/launch/ reach MainActivity as content:// URIs; downloaded updates (cache/updates/) reach Android's installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.launch"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/launch_paths" />
        </provider>
        <!-- Where an update's install session answers; it reopens the launcher after the update -->
        <activity
            android:name=".launcher.update.UpdateStatusActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- MainActivity.switchGame: a new ROM while a game is loaded starts the game screen in a fresh process -->
        <activity
            android:name=".RestartActivity"
            android:exported="false"
            android:process=":restart"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- RAOfflineProxy's host override (RetroAchievementsHostOverrideReceiver.kt): it finds this class by name, keep it -->
        <receiver android:name=".achievements.RetroAchievementsHostOverrideReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.action.SET_RETROACHIEVEMENTS_HOST_OVERRIDE" />
                <action android:name="${applicationId}.action.CLEAR_RETROACHIEVEMENTS_HOST_OVERRIDE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
