#version 450
// Sharpening › CAS: AMD FidelityFX CAS (MIT, third_party/ffx/cas) in its scaling mode, straight from
// the core's picture to the screen size, then the colour step.
layout(local_size_x = 8, local_size_y = 8) in;
#include "post_common.glsl"

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"

AF3 CasLoad(ASU2 p) { return texelFetch(imgSrc, clamp(p, ivec2(0), srcSize() - 1), 0).rgb; }
void CasInput(inout AF1 r, inout AF1 g, inout AF1 b) {} // already 0..1, as shown

#include "ffx_cas.h"

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(imgDst);
    if (p.x >= outSize.x || p.y >= outSize.y) return;
    AF3 c;
    CasFilter(c.r, c.g, c.b, AU2(p), pc.c0, pc.c1, false);
    imageStore(imgDst, p, vec4(applyColour(c), 1.0));
}
