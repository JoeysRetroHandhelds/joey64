#version 450
// Sharpening › FSR, step 1: AMD FidelityFX FSR 1 EASU (MIT, third_party/ffx/fsr1), the core's picture
// scaled to the screen size along its edges. post_rcas.comp sharpens it and applies the colour.
layout(local_size_x = 8, local_size_y = 8) in;
#include "post_common.glsl"

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"

#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return textureGather(imgSrc, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(imgSrc, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(imgSrc, p, 2); }

#include "ffx_fsr1.h"

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(imgDst);
    if (p.x >= outSize.x || p.y >= outSize.y) return;
    AF3 c;
    FsrEasuF(c, AU2(p), pc.c0, pc.c1, pc.c2, pc.c3);
    imageStore(imgDst, p, vec4(c, 1.0));
}
