#version 450
// Sharpening › FSR, step 2: AMD FidelityFX FSR 1 RCAS (MIT, third_party/ffx/fsr1) on EASU's picture
// (same size as the output), then the colour step.
layout(local_size_x = 8, local_size_y = 8) in;
#include "post_common.glsl"

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"

#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(imgSrc, clamp(p, ivec2(0), textureSize(imgSrc, 0) - 1), 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}

#include "ffx_fsr1.h"

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(imgDst);
    if (p.x >= outSize.x || p.y >= outSize.y) return;
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, AU2(p), pc.c0);
    imageStore(imgDst, p, vec4(applyColour(c), 1.0));
}
